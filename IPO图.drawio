        <mxCell id="H25OeniXnKrGn6mi9dhG-828" parent="H25OeniXnKrGn6mi9dhG-827" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;fontSize=8;" value="&lt;div style=&quot;line-height: 110%;&quot;&gt;&lt;div&gt;&lt;font style=&quot;line-height: 110%;&quot;&gt;输入数据：&lt;span style=&quot;text-align: justify;&quot;&gt;出入库单据&lt;/span&gt;ID&amp;nbsp;id、&lt;/font&gt;&lt;span style=&quot;line-height: 110%;&quot;&gt;状态 status、审核&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt;状态 auditStatus&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt;等&lt;/span&gt;&lt;span style=&quot;line-height: 110%;&quot;&gt;盘点任务单&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt;基础信息、&lt;/span&gt;&lt;span style=&quot;text-align: justify; line-height: 110%;&quot;&gt;出入库&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt;物料清单信息&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 110%;&quot;&gt;数据处理：&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;line-height: 110%;&quot;&gt;if&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;id==&#39;存在&#39; &lt;/span&gt;&amp;amp;&amp;amp; (&lt;/font&gt;&lt;span style=&quot;background-color: transparent; text-align: left; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt;status==&#39;已入库&#39;||status==&#39;已出库&#39;)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; text-align: left; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt;&amp;nbsp;&amp;amp;&amp;amp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: left; line-height: 110%;&quot;&gt;auditStatus==&#39;审批通过&#39;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;line-height: 110%;&quot;&gt;then&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;更新出入库&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;物料库存&lt;/span&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt;&amp;nbsp;else 无法&lt;/span&gt;&lt;span style=&quot;text-align: left; line-height: 110%;&quot;&gt;更新库存&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 110%;&quot;&gt;&amp;nbsp;endif&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;line-height: 110%;&quot;&gt;输出数据：无&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
