xt-align: justify;&quot;&gt;&lt;font style=&quot;line-height: 130%;&quot;&gt;if&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;id==&#39;存在&#39; &lt;/span&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;line-height: 130%;&quot;&gt;then 编辑&lt;span style=&quot;text-align: left;&quot;&gt;申请&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;物料&lt;/span&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;else 申请物料不存在&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;endif&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;line-height: 130%;&quot;&gt;输出数据：无&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
