height: 11px;&quot;&gt;else if&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;materialId!=null then 根据物料ID查询&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;else 查询全部&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;line-height: 11px;&quot;&gt;输出数据：库存流水列表&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
