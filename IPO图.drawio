        <mxCell id="H25OeniXnKrGn6mi9dhG-1000" parent="H25OeniXnKrGn6mi9dhG-999" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;fontSize=8;" value="&lt;div style=&quot;line-height: 110%;&quot;&gt;&lt;div&gt;&lt;font style=&quot;line-height: 11px;&quot;&gt;输入数据：物料库ID&amp;nbsp;stockId、物料分类ID materialTypeId、物料名称name、物料编码code、品牌brand、规格specification&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 11px;&quot;&gt;数据处理：&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 11px;&quot;&gt;if stockId!=null then 根据物料库ID查询&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;else if&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;line-height: 11px;&quot;&gt;materialTypeId&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;!=null then 根据&lt;/span&gt;&lt;span style=&quot;line-height: 11px;&quot;&gt;物料分类&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;查询&lt;/span&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;else if&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;line-height: 11px;&quot;&gt;name&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;!=null then 根据物料名称模糊查询&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; line-height: 11px;&quot;&gt;else if&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;line-height: 11px;&quot;&gt;code&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; line-height: 11px;&quot;&gt;!=null then 根据品牌模糊查询&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;else if&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;line-height: 11px;&quot;&gt;specification&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;!=null then 根据规格模糊查询&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); line-height: 11px;&quot;&gt;else 查询全部&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;line-height: 11px;&quot;&gt;输出数据：出入库单据列表&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="280" as="geometry">
            <mxRectangle height="125" width="280" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
