        <mxCell id="H25OeniXnKrGn6mi9dhG-290" parent="H25OeniXnKrGn6mi9dhG-289" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;fontSize=8;" value="&lt;div style=&quot;line-height: 130%;&quot;&gt;&lt;div&gt;&lt;font style=&quot;line-height: 130%;&quot;&gt;输入数据：采购单ID id、&lt;/font&gt;&lt;font style=&quot;line-height: 13px;&quot;&gt;采购&lt;/font&gt;&lt;span&gt;状态 status、审核&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;状态 auditStatus&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;等采购单基础信息、采购物料清单信息&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 130%;&quot;&gt;数据处理：&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;line-height: 130%;&quot;&gt;if&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;id==&#39;存在&#39; &lt;/span&gt;&amp;nbsp;&amp;amp;&amp;amp;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: left;&quot;&gt;status==&#39;已入库&#39; &amp;amp;&amp;amp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); text-align: left;&quot;&gt;auditStatus==&#39;审批通过&#39;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;font style=&quot;line-height: 130%;&quot;&gt;then&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;更新采购物料库存&lt;/span&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;else 采购单不存在&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;endif&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;line-height: 130%;&quot;&gt;输出数据：无&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
