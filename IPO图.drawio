 style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;缺货预警物料列表&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
